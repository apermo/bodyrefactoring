# Secure Schedule Access (Apache)
# Deny direct access to JSON files; all access must go through index.php API

# Deny direct access to all JSON files
<FilesMatch "\.json$">
	Order Allow,Deny
	Deny from all
</FilesMatch>

# URL rewrites for clean API endpoints
<IfModule mod_rewrite.c>
	RewriteEngine On

	# Rewrite /schedules/day/ to /schedules/day.php
	RewriteRule ^day/?$ day.php [L,QSA]

	# All other requests go through index.php
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteRule ^(.*)$ index.php [L]
</IfModule>
