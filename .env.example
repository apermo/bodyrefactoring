# Deployment Configuration
# Copy this file to .env and update with your actual values

# GitHub Webhook Secret (generate with: openssl rand -hex 32)
DEPLOY_SECRET=your-secret-token-here

# Absolute path to your repository on the server
REPO_PATH=/var/www/vhosts/your-domain.com/httpdocs

# Mode Reset Password

RESET_PASSWORD_MODE=lorem-ipsum

# Debug Mode (true/false)

DEBUG_MODE=false

# ============================================
# App Customization
# ============================================
# Note: App branding (name, icon, colors) is configured via config/app-settings.json
# See docs/configuration.md for details.

# Schedule Configuration
# SCHEDULE_PATH - Directory for schedule files (default: "schedules")
# SCHEDULE_PATH=trainings

# ============================================
# Authentication Configuration
# ============================================
# Generate password hashes with: php -r "echo password_hash('your-password', PASSWORD_BCRYPT);"

# Admin password (required for protected instances)
# Controls access to: schedule upload, database installer, settings
# ADMIN_PASSWORD_HASH=$2y$10$...

# User access configuration
# ALLOW_USER_ACCESS=true means app can be used without admin login
# Set to false to require admin login for all access
# ALLOW_USER_ACCESS=true

# Optional user password (only applies when ALLOW_USER_ACCESS=true)
# If set, users must enter this password to use the app
# If not set, app is accessible without login (admin features still protected)
# USER_PASSWORD_HASH=$2y$10$...

# Development mode (yolo mode) - bypasses all authentication
# Set to your local domain to skip auth checks entirely
# WARNING: Only use for local development!
# DEV_DOMAIN=bodyrefactoring.ddev.site

# Session duration in seconds (default: 1 year)
# SESSION_DURATION=31536000

# ============================================
# Database Configuration (MySQL)
# ============================================
# Required for schedule API with database backend.
# DDEV defaults shown - update for Plesk or other environments.

DB_HOST=db
DB_NAME=db
DB_USER=db
DB_PASS=db
# DB_PORT=3306

# Database version (set automatically by installer)
# Do not edit manually - used to track schema version
# DATABASE_VERSION=1
