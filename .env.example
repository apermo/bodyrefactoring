# Deployment Configuration
# Copy this file to .env and update with your actual values

# GitHub Webhook Secret (generate with: openssl rand -hex 32)
DEPLOY_SECRET=your-secret-token-here

# Absolute path to your repository on the server
REPO_PATH=/var/www/vhosts/your-domain.com/httpdocs

# Mode Reset Password

RESET_PASSWORD_MODE=lorem-ipsum

# Debug Mode (true/false)

DEBUG_MODE=false

# ============================================
# App Customization
# ============================================
# Note: App branding (name, icon, colors) is configured via config/app-settings.json
# See docs/configuration.md for details.

# Schedule Configuration
# SCHEDULE_PATH - Directory for schedule files (default: "schedules")
# SCHEDULE_PATH=trainings

# Authentication (optional - leave empty for public instance)
# Generate hash with: php -r "echo password_hash('your-password', PASSWORD_BCRYPT);"
# APP_PASSWORD_HASH=$2y$10$...

# Session duration in seconds (default: 1 year)
# SESSION_DURATION=24966000

# ============================================
# Database Configuration (MySQL)
# ============================================
# Required for schedule API with database backend.
# DDEV defaults shown - update for Plesk or other environments.

DB_HOST=db
DB_NAME=db
DB_USER=db
DB_PASS=db
# DB_PORT=3306
