#!/bin/bash
#
# Git pre-commit hook to run lint-staged
# Validates code quality before allowing commits
#
# This hook runs:
# - PHPCS for PHP files
# - ESLint for JavaScript files
# - Stylelint for CSS files

# Color codes for output
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m' # No Color

echo "🔍 Running lint-staged..."

# Check if node_modules exists
if [ ! -d "node_modules" ]; then
	echo -e "${YELLOW}⚠️  node_modules not found. Skipping JavaScript and CSS linting.${NC}"
	echo "   Run 'npm install' to enable full linting."
	echo ""
fi

# Check if vendor exists (for PHPCS)
if [ ! -d "vendor" ]; then
	echo -e "${YELLOW}⚠️  vendor not found. Skipping PHP linting.${NC}"
	echo "   Run 'composer install' to enable PHP linting."
	echo ""
fi

# Run lint-staged if available
if [ -f "node_modules/.bin/lint-staged" ]; then
	npx lint-staged
	LINT_STATUS=$?

	if [ $LINT_STATUS -ne 0 ]; then
		echo ""
		echo -e "${RED}❌ Linting failed!${NC}"
		echo "   Please fix the issues above before committing."
		echo ""
		echo "   To auto-fix issues, run:"
		echo "     npm run lint:fix"
		echo ""
		echo "   To bypass linting (not recommended):"
		echo "     git commit --no-verify"
		exit 1
	fi

	echo -e "${GREEN}✓ Linting passed${NC}"
else
	echo -e "${YELLOW}⚠️  lint-staged not installed. Skipping pre-commit linting.${NC}"
	echo "   Run 'npm install' to enable linting."
fi

exit 0
